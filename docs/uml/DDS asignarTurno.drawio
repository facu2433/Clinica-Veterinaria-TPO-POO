        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam sequence {\n    ParticipantBackgroundColor #EAEAF2\n    ParticipantBorderColor #666666\n    ActorBackgroundColor #F4F4F9\n    ActorBorderColor #666666\n    LifeLineBorderColor #666666\n    ArrowColor #000000\n}\n\nactor Recepcionista\nparticipant \&quot;:ControladorClinica\&quot; as Controlador\nparticipant \&quot;v:Veterinario\&quot; as Veterinario\nparticipant \&quot;t:Turno\&quot; as Turno\n\nRecepcionista -&gt; Controlador : asignarTurno(mascota, v, fechaHora, duracion)\nactivate Controlador\n\nControlador -&gt; Veterinario : estaDisponible(fechaHora, duracion)\nactivate Veterinario\nVeterinario --&gt; Controlador : disponible\ndeactivate Veterinario\n\nalt disponible == true\n    Controlador -&gt; Turno ** : new Turno(mascota, v, fechaHora, tipoAtencion)\n    Controlador --&gt; Recepcionista : turnoConfirmado\nelse disponible == false\n    Controlador --&gt; Recepcionista : throw TurnoSuperpuestoException\nend\n\ndeactivate Controlador\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DcnypHLUjQVUoMR2ufDN-39">
