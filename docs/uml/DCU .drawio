        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam usecase {\n    BackgroundColor #F4F4F9\n    BorderColor #666666\n    ArrowColor #000000\n}\nskinparam actor {\n    BackgroundColor #EAEAF2\n    BorderColor #666666\n}\nskinparam rectangle {\n    BorderColor #666666\n    BorderThickness 1.5\n}\n\nactor \&quot;Recepcionista\&quot; as rec\nactor \&quot;Veterinario\&quot; as vet\n\nactor \&quot;Dueño de la mascota\&quot; as due\nactor \&quot;Administrador\&quot; as adm\n\nrectangle \&quot;Clínica Veterinaria Patitas\&quot; {\n    \n    usecase \&quot;Registrar Dueño y Mascota\&quot; as UC1\n    usecase \&quot;Asignar Turno\&quot; as UC2\n    usecase \&quot;Asignar Turno de Urgencia\&quot; as UC4\n    usecase \&quot;Cancelar / Reprogramar\&quot; as UC3\n    \n    usecase \&quot;Registrar Consulta\&quot; as UC5\n    usecase \&quot;Aplicar Vacuna\&quot; as UC6\n    usecase \&quot;Facturar Atención\&quot; as UC7\n    usecase \&quot;Descontar Stock\&quot; as UC8\n    \n    usecase \&quot;Pagar Factura\&quot; as UC9\n    usecase \&quot;Aplicar Descuento/Recargo\&quot; as UC10\n    usecase \&quot;Emitir Recordatorio\&quot; as UC11\n    \n    usecase \&quot;Consultar Reportes\&quot; as UC12\n}\n\n&#39; Relaciones de los actores a la izquierda\nrec --&gt; UC1\nrec --&gt; UC2\nrec --&gt; UC3\nUC4 .&gt; UC2 : &lt;&lt;extend&gt;&gt;\n\nvet --&gt; UC5\nUC6 .&gt; UC5 : &lt;&lt;extend&gt;&gt;\nUC5 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC8 : &lt;&lt;include&gt;&gt;\n\n&#39; Relaciones de los actores a la derecha (las flechas se escriben al revés para que el actor quede a la derecha)\nUC9 &lt;-- due\nUC10 .&gt; UC9 : &lt;&lt;extend&gt;&gt;\nUC11 &lt;-- due\n\nUC12 &lt;-- adm\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yPjGpvtIUqEmFcHFdgBt-69">
